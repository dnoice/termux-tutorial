---
import '../styles/hub.css';

interface Props {
	title: string;
	description: string;
}
const { title, description } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = Astro.site ? Astro.site.origin : 'https://dnoice.github.io';
const canonical = `${site}${base}/`;

/* ====================================================================== *
 * FONTS — the hub shipped NONE of these until 2026-08-11.
 *
 * _tokens.css exists so the hub and the courses are provably one product,
 * and it declares --font-heading (Crimson Pro), --font-detail (Source Serif
 * 4) and --font-ui (Inter). But @font-face is registered PER DOCUMENT: a
 * woff2 already cached from a course page cannot be used by a hub page that
 * never declares the family. With no declaration here, every one of those
 * tokens silently fell to its fallback — Georgia for both serif roles, the
 * system UI face for Inter — so the front door of the series rendered in
 * different type from every room behind it, and nothing failed.
 *
 * Same eight latin faces as the courses, same unicode-range, same two
 * preloads. The courses generate this from FONT_FACES in astro.config.mjs;
 * the hub is not Starlight and has no such hook, so it lives here.
 *
 * KEEP IN STEP WITH THE COURSES: the files in hub/public/fonts/ are copies of
 * termux-tutorial-for-beginners/public/fonts/, which `npm run fonts:sync`
 * writes there. Change a family in a course and copy it across, or the hub
 * drifts back to Georgia without a single error.
 */
const LATIN_RANGE =
	'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';

interface FontFace {
	family: string;
	file: string;
	weight: string;
	preload?: boolean;
}

const FONT_FACES: FontFace[] = [
	// preload: above the fold on both hub pages — Inter is the chrome, Crimson
	// Pro is the hero h1, i.e. the LCP element.
	{ family: 'Inter Variable', file: 'inter-latin-wght', weight: '100 900', preload: true },
	{ family: 'Crimson Pro Variable', file: 'crimson-pro-latin-wght', weight: '200 900', preload: true },
	{ family: 'Source Serif 4 Variable', file: 'source-serif-4-latin-wght', weight: '200 900' },
	{ family: 'JetBrains Mono Variable', file: 'jetbrains-mono-latin-wght', weight: '100 800' },
];

const fontUrl = (f: FontFace, style: 'normal' | 'italic') =>
	`${base}/fonts/${f.file}-${style}.woff2`;
const fontFaceCss = FONT_FACES.flatMap((f) =>
	(['normal', 'italic'] as const).map(
		(style) =>
			`@font-face{font-family:'${f.family}';font-style:${style};font-display:swap;` +
			`font-weight:${f.weight};src:url(${fontUrl(f, style)}) format('woff2-variations');` +
			`unicode-range:${LATIN_RANGE};}`
	)
).join('');
---

<!doctype html>
<html lang="en" dir="ltr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={`${site}${base}/og-default.png`} />
		<meta name="twitter:card" content="summary_large_image" />

		<link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />

		{/* Fonts are always fetched in CORS mode, even same-origin. Without
		    crossorigin the preload is discarded and the file downloads twice. */}
		{
			FONT_FACES.filter((f) => f.preload).map((f) => (
				<link
					rel="preload"
					href={fontUrl(f, 'normal')}
					as="font"
					type="font/woff2"
					crossorigin="anonymous"
				/>
			))
		}
		<style set:html={fontFaceCss}></style>

		{/*
		 * PRE-PAINT THEME, and it has to honour Starlight's contract.
		 *
		 * The courses are Starlight sites whose theme lives in the
		 * `starlight-theme` localStorage key (light | dark | auto) with the
		 * resolved value on <html data-theme>. The hub is not Starlight, but it
		 * is the same origin — so it reads and writes the SAME key. A theme
		 * chosen in a course carries into the hub and back, which is the whole
		 * point of a hub that does not feel like a different website.
		 *
		 * Inline and synchronous, before first paint: anything later is a flash
		 * of the wrong theme on every visit.
		 */}
		<script is:inline>
			(() => {
				const root = document.documentElement;
				let mode = 'auto';
				try {
					const v = localStorage.getItem('starlight-theme');
					if (v === 'light' || v === 'dark' || v === 'auto') mode = v;
				} catch {
					/* storage blocked — fall through to auto */
				}
				const resolved =
					mode === 'auto'
						? matchMedia('(prefers-color-scheme: dark)').matches
							? 'dark'
							: 'light'
						: mode;
				root.setAttribute('data-theme', resolved);
				root.setAttribute('data-tmx-mode', mode);
			})();
		</script>
	</head>
	<body>
		<slot />

	</body>
</html>
