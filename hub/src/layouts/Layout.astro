---
import '../styles/hub.css';

interface Props {
	title: string;
	description: string;
}
const { title, description } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = Astro.site ? Astro.site.origin : 'https://dnoice.github.io';
const canonical = `${site}${base}/`;
---

<!doctype html>
<html lang="en" dir="ltr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={`${site}${base}/og-default.png`} />
		<meta name="twitter:card" content="summary_large_image" />

		<link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />

		{/*
		 * PRE-PAINT THEME, and it has to honour Starlight's contract.
		 *
		 * The courses are Starlight sites whose theme lives in the
		 * `starlight-theme` localStorage key (light | dark | auto) with the
		 * resolved value on <html data-theme>. The hub is not Starlight, but it
		 * is the same origin — so it reads and writes the SAME key. A theme
		 * chosen in a course carries into the hub and back, which is the whole
		 * point of a hub that does not feel like a different website.
		 *
		 * Inline and synchronous, before first paint: anything later is a flash
		 * of the wrong theme on every visit.
		 */}
		<script is:inline>
			(() => {
				const root = document.documentElement;
				let mode = 'auto';
				try {
					const v = localStorage.getItem('starlight-theme');
					if (v === 'light' || v === 'dark' || v === 'auto') mode = v;
				} catch {
					/* storage blocked — fall through to auto */
				}
				const resolved =
					mode === 'auto'
						? matchMedia('(prefers-color-scheme: dark)').matches
							? 'dark'
							: 'light'
						: mode;
				root.setAttribute('data-theme', resolved);
				root.setAttribute('data-tmx-mode', mode);
			})();
		</script>
	</head>
	<body>
		<slot />

		<script is:inline>
			/*
			 * The theme toggle: light -> dark -> auto, mirroring the courses'
			 * ThemeSelect so the control behaves identically on both sides of a
			 * navigation. Writes the same key, so the choice survives the jump.
			 */
			(() => {
				const root = document.documentElement;
				const order = ['light', 'dark', 'auto'];
				const label = {
					light: 'Theme: light. Switch to dark.',
					dark: 'Theme: dark. Switch to system.',
					auto: 'Theme: system. Switch to light.',
				};
				const apply = (mode) => {
					const resolved =
						mode === 'auto'
							? matchMedia('(prefers-color-scheme: dark)').matches
								? 'dark'
								: 'light'
							: mode;
					root.setAttribute('data-theme', resolved);
					root.setAttribute('data-tmx-mode', mode);
					try {
						localStorage.setItem('starlight-theme', mode);
					} catch {
						/* preference simply will not persist */
					}
					for (const b of document.querySelectorAll('.hub__theme')) {
						b.setAttribute('aria-label', label[mode]);
					}
				};
				document.addEventListener('click', (e) => {
					const btn = e.target instanceof Element && e.target.closest('.hub__theme');
					if (!btn) return;
					const now = root.getAttribute('data-tmx-mode') || 'auto';
					apply(order[(order.indexOf(now) + 1) % order.length]);
				});
				// Follow the system while the choice is "auto".
				matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
					if ((root.getAttribute('data-tmx-mode') || 'auto') === 'auto') apply('auto');
				});
				apply(root.getAttribute('data-tmx-mode') || 'auto');
			})();
		</script>
	</body>
</html>
