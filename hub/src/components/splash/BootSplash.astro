---
/*
 * BootSplash — a sequenced boot animation over the landing page.
 *
 * Total runtime is DERIVED, not stated here — see THE SCHEDULE below. Any
 * number written into this comment would be the first thing to go stale.
 *
 * THE RULES THIS OBEYS, because a splash screen is a tax on everyone who did
 * not ask for it and the difference between "sophisticated" and "infuriating"
 * is entirely in the guard rails:
 *
 *   1. ONCE PER SESSION. sessionStorage, not localStorage — it should feel like
 *      arriving, not like a paywall. Navigate into a lesson and back and you
 *      will never see it twice.
 *   2. LANDING PAGE ONLY. Mounted from index.mdx, not a layout override. The
 *      last thing that rendered site-wide took the sticky header with it.
 *   3. SKIPPABLE INSTANTLY. Any click, key, scroll or touch ends it. Someone
 *      who wants to read is never made to wait.
 *   4. REDUCED MOTION MEANS NO SPLASH, not a fast one. A 4s sequence compressed
 *      to 0.1s is a strobe, which is worse than nothing.
 *   5. NEVER BLOCKS. The page is fully rendered and interactive underneath the
 *      whole time; this is a curtain, not a loading gate. Nothing waits on it.
 *   6. FAILS OPEN. The markup ships `hidden` and an inline pre-paint script
 *      REVEALS it. No JS, a thrown script, an unsupported API — any of those
 *      and the splash simply never appears, rather than covering the site
 *      forever with no way to dismiss it. (The inverse mistake — markup that
 *      needs JS to become visible — is what made the scatter field vanish.)
 *
 * The artwork is termux_linux_elements.svg, inlined so its named parts become
 * addressable. That naming is why this works where the scatter field did not:
 * these are eight DESIGNED chips with labels, not generic scattered icons, so
 * animating them individually is the point rather than an intrusion.
 */
import raw from '../../assets/termux_linux_elements.svg?raw';

/*
 * Tag the parts the sequence drives. Build time, so runtime cost is zero and
 * the file on disk stays the canonical artwork.
 *
 * EVERY REWRITE IS ASSERTED. A `.replace()` that matches nothing returns the
 * input unchanged and reports success, and this file was bitten by exactly
 * that twice — the artwork is Inkscape-pretty-printed, so `<svg ` and
 * `<rect width="1280" height="832" ...>` both look right and both match
 * NOTHING, because the real markup puts every attribute on its own line. The
 * symptom is a silent visual bug with correct-looking CSS that has no element
 * to match. `must()` turns that into a failed build, which is where a broken
 * assumption about someone else's file format belongs.
 */
function must(input: string, pattern: RegExp | string, replacement: string, what: string): string {
	const out = input.replace(pattern as RegExp, replacement);
	if (out === input) {
		throw new Error(
			`BootSplash: "${what}" matched nothing in termux_linux_elements.svg. ` +
				`The artwork changed shape — fix the pattern rather than shipping a splash with a missing part.`
		);
	}
	return out;
}

let svg = raw.replace(/<\?xml[^>]*\?>/, '').replace(/<!--[\s\S]*?-->/, '');

/* Drop the artwork's own backdrop rect. The SVG has to letterbox to keep all
   eight chips in frame, so a baked-in background paints a hard-edged panel
   floating on the page canvas — it reads as a pasted-in image rather than a
   boot screen. The glow is worth keeping, so it is re-created on the overlay
   in CSS from the same stops, where it covers the full viewport and can follow
   the theme. The `dots` rect stays: that texture is transparent and lands on
   the canvas correctly. */
svg = must(svg, /<rect\b[^>]*?url\(#bgGlow\)[^>]*?\/>/, '', 'strip bgGlow backdrop');

// The window frame — the first thing to arrive.
svg = must(svg, /id="terminal"/, 'id="terminal" class="tmx-splash__window"', 'tag terminal window');

/* The console lines, in document order. Everything below the title bar (y>=300)
   is output; the title itself and the prompt mark are chrome and arrive with
   the frame. Attributes are newline-separated in the source, hence \s+. */
let line = 0;
svg = svg.replace(/<text\s+x="424"\s+y="(\d+)"/g, (m, y) =>
	Number(y) >= 300 ? `<text class="tmx-splash__line" style="--i:${line++}" x="424" y="${y}"` : m
);
if (line === 0) throw new Error('BootSplash: tagged no console lines — the terminal markup changed.');

/* The eight chips. Ordered by their id so the stagger is stable rather than
   dependent on how the editor happened to serialise the document. */
const CHIPS = [
	'chip-penguin', 'chip-code', 'chip-droid', 'chip-database',
	'chip-gear', 'chip-git', 'chip-package', 'chip-fish',
];
CHIPS.forEach((id, i) => {
	svg = must(
		svg,
		new RegExp(`id="${id}"`),
		`id="${id}" class="tmx-splash__chip" style="--i:${i}"`,
		`tag ${id}`
	);
});

// The closing wordmark.
svg = must(svg, /<text([^>]*id="text71")/, '<text class="tmx-splash__wordmark"$1', 'tag wordmark');

// Regex, not the string '<svg ' — see must() above for why that matters here.
svg = must(
	svg,
	/<svg\b/,
	'<svg class="tmx-splash__art" aria-hidden="true" focusable="false"',
	'tag svg root'
);

/* ====================================================================== *
 * THE SCHEDULE — one source of truth for the CSS and the teardown timer.
 *
 * The first cut felt rushed, and the cause was structural rather than any one
 * duration being too short:
 *
 *   1. THE PHASES OVERLAPPED. Lines began at 650ms while the window was still
 *      arriving (it landed at 700ms), and chips began at 1500ms while lines
 *      were still typing until 2270ms — 770ms of two separate things moving at
 *      once. Simultaneous motion reads as busy; sequential motion reads as
 *      deliberate.
 *   2. THE CADENCE WAS INCONSISTENT — 165ms between lines against 190ms
 *      between chips. Close enough to read as a mistake rather than a choice.
 *   3. THERE WAS NO HOLD. The curtain lifted 100ms after the wordmark landed,
 *      so the assembled composition was never actually on screen. Biggest of
 *      the three, because it means the payoff frame did not exist.
 *
 * Now each phase has the stage to itself, phases are separated by a BEAT of
 * stillness, one cadence runs throughout, and the whole thing HOLDS before it
 * lifts.
 *
 * Every number below is derived rather than hand-computed, and this object
 * emits BOTH the CSS custom properties and the teardown delay — so the
 * "change one, change the other" hazard the previous version carried is gone.
 * ====================================================================== */
const T = {
	window: 700,   // the frame arrives
	beat: 280,     // stillness between phases — the thing that separates them
	line: 280,     // one output line reveals
	lineStep: 120, // cadence between lines: a boot log SHOULD scroll briskly
	chip: 520,     // one chip settles into place, on --ease-settle
	chipStep: 300, // cadence between chips — see the note below
	word: 760,     // the wordmark tracks in
	hold: 1000,    // everything still, so the finished composition is SEEN
	fade: 600,     // the curtain
};

/*
 * WHY THESE NUMBERS, since "make it slower" was tried twice and did not work.
 *
 * The splash felt rushed at a five-and-three-quarter-second runtime, which
 * should have been the clue: the problem was never the total. Two things caused
 * it, and both are about what the eye can actually resolve.
 *
 * 1. EASING. Everything ran on --ease-out, an expo curve that is 83% finished a
 *    quarter of the way through. A 560ms chip therefore read as a ~140ms snap
 *    plus an invisible tail, and every extra millisecond went into the tail.
 *    Chips and the wordmark now use --ease-settle, which spreads the motion and
 *    lands with a slight overshoot.
 *
 * 2. OVERLAP. chipStep was 170ms against a 560ms chip, so 3.3 chips were moving
 *    at any instant — a continuous swarm in which no single chip is ever seen
 *    ARRIVING. At 300ms against 520ms it is ~1.7: each chip is most of the way
 *    home before the next starts, which reads as a cascade rather than a burst.
 *    That ratio is the dial. Below about 0.5 it becomes a swarm again.
 *
 * The lines are deliberately still brisk — they are a boot log, and a log that
 * scrolls fast is authentic rather than hurried. The hold more than doubled,
 * because the composition arriving is the payoff and it needs a beat of
 * stillness to register as finished rather than interrupted.
 */

const linesStart = T.window + T.beat;
const linesEnd = linesStart + (line - 1) * T.lineStep + T.line;
const chipsStart = linesEnd + T.beat;
const chipsEnd = chipsStart + (CHIPS.length - 1) * T.chipStep + T.chip;
const wordStart = chipsEnd + T.beat;
/** The moment nothing is moving any more — when the curtain may lift. */
const teardownAt = wordStart + T.word + T.hold;

const scheduleVars = [
	`--t-window:${T.window}ms`,
	`--t-line:${T.line}ms`,
	`--t-line-step:${T.lineStep}ms`,
	`--t-lines-start:${linesStart}ms`,
	`--t-chip:${T.chip}ms`,
	`--t-chip-step:${T.chipStep}ms`,
	`--t-chips-start:${chipsStart}ms`,
	`--t-word:${T.word}ms`,
	`--t-word-start:${wordStart}ms`,
	`--t-fade:${T.fade}ms`,
].join(';');
---

<div
	class="tmx-splash"
	data-tmx-splash
	data-teardown={String(teardownAt)}
	style={scheduleVars}
	hidden
	aria-hidden="true"
	set:html={svg}
/>

<script is:inline>
	/*
	 * Inline and synchronous: it has to decide BEFORE first paint, or the
	 * splash flashes in after the page is already visible, which is the one
	 * thing worse than a splash.
	 */
	(() => {
		const el = document.querySelector('[data-tmx-splash]');
		if (!el) return;

		const KEY = 'tmx:splash-seen';
		let seen = false;
		try {
			seen = sessionStorage.getItem(KEY) === '1';
			sessionStorage.setItem(KEY, '1');
		} catch {
			// Private mode / storage disabled. Treat as seen: showing the splash
			// on every single navigation is far worse than never showing it.
			seen = true;
		}

		const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
		if (seen || calm) {
			el.remove();
			return;
		}

		/* Reparent to <body> before revealing. The component is authored inside
		   the page content, and a fixed element with z-index still cannot escape
		   an ancestor that establishes a stacking context — which is why the
		   header painted OVER a z-index:100 overlay. Hoisting to the root makes
		   the layering depend on nothing but our own z-index. */
		document.body.appendChild(el);

		el.hidden = false;
		document.documentElement.setAttribute('data-splash', '');

		let done = false;
		const end = () => {
			if (done) return;
			done = true;
			el.setAttribute('data-leaving', '');
			document.documentElement.removeAttribute('data-splash');
			// Outlast the fade, then stop existing — an inert full-screen layer
			// is still a layer.
			setTimeout(() => el.remove(), 600);
		};

		/*
		 * The full sequence, and every way to cut it short. The delay is read
		 * from data-teardown, which the component derived from the same
		 * constants the CSS animations use — so this timer cannot drift out of
		 * step with the animation it is waiting on.
		 */
		const teardown = Number(el.getAttribute('data-teardown')) || 5800;
		const timer = setTimeout(end, teardown);
		const skip = () => {
			clearTimeout(timer);
			end();
		};
		for (const ev of ['pointerdown', 'keydown', 'wheel', 'touchstart']) {
			addEventListener(ev, skip, { once: true, passive: true });
		}
	})();
</script>
