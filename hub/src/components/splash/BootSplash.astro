---
/*
 * Termux Constellation boot splash.
 *
 * Authored by Dennis 'dendogg' Smaltz as a standalone review harness at
 * scratchpad/load-screen-idea/termux-boot-splash.html, with the choreography
 * documented in SPLASH_INTEGRATION.md alongside it. That file remains the
 * place to review and retime the sequence; this is the port into Astro, and
 * the two should be diffable.
 *
 * WHAT MAKES THIS DIFFERENT FROM THE COMPONENT IT REPLACES, and why it is
 * worth the size: the chips are not "entrance animated" at all. Eight traces
 * fire outward along the artwork's own wire paths, and each chip detonates as
 * its trace lands on it. The motion is therefore CAUSED rather than merely
 * staggered — which is why a 0.16s stagger reads as eight distinct arrivals
 * here, where 0.17s read as one moving mass in the version before it. Nothing
 * shares a direction, so nothing groups.
 *
 * IT ALSO NEVER TOUCHES THE ARTWORK. The previous component rewrote the SVG
 * with regex at build time to inject class names, which is a bad bet against a
 * hand-authored Inkscape file — attributes sit on their own lines, so a
 * re-export could silently stop matching. The engine here binds by element id
 * and mutates nothing, so the drawing ships exactly as it was drawn.
 *
 * The `?raw` import keeps ONE artwork of record: global-assets/ is the file
 * you edit, scripts/sync-assets.mjs copies it into each project, and
 * `npm run assets:check` fails if a copy drifts.
 */
import '../splash/splash.css';
import rawSvg from '../../assets/termux_linux_elements.svg?raw';

interface Props {
	/** Header wordmark. Defaults to the series, not a single course. */
	title?: string;
	subtitle?: string;
}
const { title = 'Termux Tutorial', subtitle = 'digiSpace Research Studio' } = Astro.props;

/*
 * Strip the XML prolog and Inkscape's leading metadata comment: neither is
 * legal or useful inside an HTML host. Everything from the opening <svg> tag
 * onward is passed through untouched.
 */
const svg = rawSvg.slice(Math.max(0, rawSvg.indexOf('<svg')));
---

<div id="termux-splash"
     role="group"
     aria-label={`Loading ${title}`}
     aria-busy="true"
     data-speed="1"
     data-auto="true"
     data-min-ms="0"
     data-failsafe-ms="16000"
     data-title={title}
     data-subtitle={subtitle}>

  <div class="tx-ticks" aria-hidden="true"><i></i><i></i><i></i><i></i></div>

  <header class="tx-head">
    <div class="tx-brand">
      <span class="tx-brand-mark" aria-hidden="true">&gt;_</span>
      <span class="tx-brand-text">
        <b data-tx-title>{title}</b>
        <em data-tx-subtitle>{subtitle}</em>
      </span>
    </div>
    <div class="tx-head-meta">
      <span class="tx-dot" aria-hidden="true"></span>
      <span>aarch64</span>
      <span aria-hidden="true">&middot;</span>
      <span>no-root</span>
    </div>
  </header>

  <div class="tx-stagewrap">
    <div class="tx-stage" id="tx-stage">
<Fragment set:html={svg} />
      <div class="tx-screen" id="tx-screen" aria-hidden="true">
        <div class="tx-flash"></div>
        <div class="tx-beam"></div>
        <div class="tx-scan"></div>
        <div class="tx-grain"></div>
        <div class="tx-vig"></div>
        <div class="tx-bezel"></div>
      </div>
    </div>
  </div>

  <footer class="tx-foot">
    <div class="tx-log" id="tx-log" aria-hidden="true"></div>

    <div class="tx-status">
      <span class="tx-phase" id="tx-phase">cold start</span>
      <span class="tx-pct"><span id="tx-pct">0</span><i>%</i></span>
    </div>

    <div class="tx-rail" id="tx-rail" role="progressbar"
         aria-label="Boot progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"></div>

    <div class="tx-actions">
      <span class="tx-hint">8 nodes &middot; no-root shell &middot; self-contained</span>
      <button type="button" class="tx-skip" id="tx-skip">skip <kbd>esc</kbd></button>
    </div>
  </footer>

  <p class="tx-sr" id="tx-sr" role="status" aria-live="polite">Loading.</p>
</div>

<noscript><style>
  /* No script: the splash can never dismiss itself, so it never shows.  */
  #termux-splash { display:none !important; }
</style></noscript>

<script is:inline>
/* ======================================================================
   Termux Constellation Boot Splash - sequence engine
   CSS owns HOW things animate; this file owns WHEN. Every timing number
   lives in the CUES / LINES / LOG / PROGRESS tables below - nowhere else.
   ====================================================================== */
(function () {
  'use strict';

  var ROOT_ID = 'termux-splash';
  var host = document.getElementById(ROOT_ID);
  if (!host) { return; }

  /* Pristine snapshot, taken before any mutation, so replay() is exact. */
  var PRISTINE = host.cloneNode(true);

  /* ---------------------------------------------------------------- map
     The only place artwork element ids appear. Re-syncing the SVG means
     checking this table, nothing else.                                  */
  var NODES = [
    { key:'linux',    group:'g28',            chip:'tux-chip',          label:'text42', wire:'path10', dot:[640,176],  hue:'#3ddc84', name:'linux kernel'   },
    { key:'ubuntu',   group:'ubuntu',         chip:'ubuntu-chip',       label:'text54', wire:'path14', dot:[918,214],  hue:'#dbe7f3', name:'ubuntu rootfs'  },
    { key:'sqlite',   group:'database',       chip:'sqlite-chip',       label:'text50', wire:'path13', dot:[1020,416], hue:'#fbbf24', name:'sqlite3'        },
    { key:'bash',     group:'bash-shell',     chip:'bash-chip',         label:'text70', wire:'path17', dot:[918,618],  hue:'#3ab14a', name:'bash 5.2'       },
    { key:'script',   group:'script-braces',  chip:'shell-script-chip', label:'text45', wire:'path11', dot:[640,656],  hue:'#22d3ee', name:'shell scripts'  },
    { key:'git',      group:'git',            chip:'git-chip',          label:'text66', wire:'path16', dot:[362,618],  hue:'#f97316', name:'git 2.49'       },
    { key:'android',  group:'android',        chip:'android-chip',      label:'text49', wire:'path12', dot:[260,416],  hue:'#3ddc84', name:'android bridge' },
    { key:'dotfiles', group:'dotfiles',       chip:'dor-chip',          label:'text62', wire:'path15', dot:[362,214],  hue:'#9fb3c8', name:'dotfiles'       }
  ];

  var LINES = [
    { id:'pkg-update',      kind:'cmd', at:1.80, dur:0.80 },
    { id:'aarch64-package', kind:'out', at:2.66, dur:0.30 },
    { id:'up-to-date',      kind:'out', at:2.98, dur:0.26 },
    { id:'pip-install',     kind:'cmd', at:3.26, dur:0.55 },
    { id:'rich-14.0',       kind:'out', at:3.87, dur:0.30 },
    { id:'ssh',             kind:'cmd', at:4.19, dur:0.60 },
    { id:'forge',           kind:'out', at:4.85, dur:0.32 },
    { id:'prompt',          kind:'out', at:5.20, dur:0.20 }
  ];

  /* Master cue sheet, in timeline seconds at speed 1. */
  var CUES = {
    field:      0.30,
    orbit:      0.50,
    orbitDash:  0.88,
    shell:      1.05,
    shellBits:  1.58,
    chrome:     5.30,
    cursor:     5.45,
    bus:        5.28,
    traceAt:    5.45,
    traceStep:  0.16,
    traceDur:   0.55,
    mountLead:  0.86,   /* chip fires at traceDur * mountLead */
    sync:       7.05,
    ready:      7.55,
    outro:      8.15
  };

  var PHASES = [
    [0.00, 'cold start'],
    [0.30, 'field wake'],
    [1.05, 'mounting shell'],
    [1.80, 'session bootstrap'],
    [5.28, 'energizing bus'],
    [5.92, 'mounting nodes'],
    [7.05, 'synchronizing'],
    [7.55, 'ready']
  ];

  var LOG = [
    [0.05, 'termux-boot: cold start',              'ok'  ],
    [0.42, 'kernel aarch64 \u00b7 page size 4K',   'ok'  ],
    [0.90, 'mount /data/data/com.termux/files',    'ok'  ],
    [1.25, 'linker64: bionic symbols resolved',    'ok'  ],
    [1.70, '$PREFIX/bin registered on PATH',       'ok'  ],
    [2.10, 'login shell: bash 5.2',                'ok'  ],
    [2.75, 'apt: reading package lists',           'info'],
    [3.30, 'python 3.12 \u00b7 pip 25.1',          'ok'  ],
    [3.95, 'venv "working env" attached',          'ok'  ],
    [4.35, 'openssh 9.9 \u00b7 known_hosts ok',    'ok'  ],
    [4.95, 'proot-distro: ubuntu rootfs detected', 'ok'  ],
    [5.35, 'node bus energized',                   'info'],
    [6.10, 'sqlite3 3.46 \u00b7 journal=wal',      'ok'  ],
    [6.60, 'git 2.49 \u00b7 credential helper up', 'ok'  ],
    [7.05, 'constellation synchronized 8/8',       'ok'  ],
    [7.60, 'handoff \u2192 course runtime',        'ok'  ]
  ];

  /* Scripted progress curve: [timeline seconds, percent]. */
  var PROGRESS = [[0,0],[0.5,4],[1.05,10],[1.8,17],[5.28,58],[7.04,90],[7.55,97],[8.15,100]];

  /* Responsive framings: pick the first whose min aspect ratio fits. */
  var FRAMES = [
    { min:1.45, box:'0 0 1280 832'    },
    { min:1.02, box:'128 28 1024 776' },
    { min:0,    box:'384 40 512 760'  }
  ];

  var SVG_NS = 'http://www.w3.org/2000/svg';

  /* ============================================================ state */
  var S = null;   /* live instance state, rebuilt on every boot/replay */

  function num(v, dflt) { var n = parseFloat(v); return isFinite(n) ? n : dflt; }
  function clamp(v, a, b) { return v < a ? a : (v > b ? b : v); }
  function byId(id) { return document.getElementById(id); }
  function svgEl(tag) { return document.createElementNS(SVG_NS, tag); }

  function interp(table, t) {
    if (t <= table[0][0]) { return table[0][1]; }
    for (var i = 1; i < table.length; i++) {
      if (t <= table[i][0]) {
        var a = table[i - 1], b = table[i];
        var f = (t - a[0]) / (b[0] - a[0] || 1);
        return a[1] + (b[1] - a[1]) * f;
      }
    }
    return table[table.length - 1][1];
  }

  function fmtClock(t) {
    var s = t.toFixed(3);
    while (s.length < 6) { s = ' ' + s; }
    return '[ ' + s + ' ]';
  }

  function emit(name, detail) {
    S.root.dispatchEvent(new CustomEvent('termux-splash:' + name, {
      bubbles: true, detail: detail || {}
    }));
  }

  /* ================================================= artwork wiring == */

  /* Delay/duration helpers - CSS divides its own durations by --tx-speed,
     so JS-supplied times are pre-scaled here to stay in the same clock. */
  function setDelay(el, seconds) {
    el.style.setProperty('--tx-d', (seconds / S.speed).toFixed(4) + 's');
  }
  function setDur(el, seconds) {
    el.style.setProperty('--tx-dur', (seconds / S.speed).toFixed(4) + 's');
  }

  function ellipseLength(el) {
    if (el && typeof el.getTotalLength === 'function') {
      try {
        var l = el.getTotalLength();
        if (l && isFinite(l) && l > 1) { return l; }
      } catch (e) { /* fall through to the closed form */ }
    }
    /* Ramanujan approximation - used when getTotalLength is unavailable
       for <ellipse> in the host engine. */
    var a = num(el && el.getAttribute('rx'), 440);
    var b = num(el && el.getAttribute('ry'), 300);
    return Math.PI * (3 * (a + b) - Math.sqrt((3 * a + b) * (a + 3 * b)));
  }

  function buildDefs(svg) {
    var defs = svg.querySelector('defs');
    if (!defs) { defs = svgEl('defs'); svg.insertBefore(defs, svg.firstChild); }

    var f = svgEl('filter');
    f.setAttribute('id', 'tx-glow');
    f.setAttribute('x', '-60%'); f.setAttribute('y', '-60%');
    f.setAttribute('width', '220%'); f.setAttribute('height', '220%');
    var blur = svgEl('feGaussianBlur');
    blur.setAttribute('stdDeviation', '2.6');
    blur.setAttribute('result', 'txb');
    var merge = svgEl('feMerge');
    var m1 = svgEl('feMergeNode'); m1.setAttribute('in', 'txb');
    var m2 = svgEl('feMergeNode'); m2.setAttribute('in', 'SourceGraphic');
    merge.appendChild(m1); merge.appendChild(m2);
    f.appendChild(blur); f.appendChild(merge);
    defs.appendChild(f);
    return defs;
  }

  /* Terminal line reveal: one primitive for every line. A clip rect over
     the line's own bounding box scales from p0 to 1 in character steps.
     Command lines set p0 at the end of the "~ $" prompt so the prompt is
     present from the start and only the command types.                  */
  function wireLine(svg, defs, spec, index) {
    var text = byId(spec.id);
    if (!text) { return null; }

    var box;
    try { box = text.getBBox(); } catch (e) { return null; }
    if (!box || !box.width) { return null; }

    var pad = 3;
    var x = box.x - pad, w = box.width + pad * 2;
    var y = box.y - pad, h = box.height + pad * 2;

    var clip = svgEl('clipPath');
    clip.setAttribute('id', 'tx-clip-' + index);
    clip.setAttribute('clipPathUnits', 'userSpaceOnUse');
    var rect = svgEl('rect');
    rect.setAttribute('x', x); rect.setAttribute('y', y);
    rect.setAttribute('width', w); rect.setAttribute('height', h);
    rect.setAttribute('class', 'tx-clip-rect');
    clip.appendChild(rect);
    defs.appendChild(clip);
    text.setAttribute('clip-path', 'url(#tx-clip-' + index + ')');

    /* Where does the typed portion begin? */
    var splitX = x, steps = (text.textContent || '').length;
    if (spec.kind === 'cmd') {
      var first = text.querySelector('tspan');
      var promptLen = first ? (first.textContent || '').length : 0;
      try {
        splitX = text.getStartPositionOfChar(promptLen).x;
        steps = Math.max(1, (text.textContent || '').length - promptLen);
      } catch (e2) {
        splitX = x; steps = Math.max(1, (text.textContent || '').length);
      }
    }

    rect.style.setProperty('--tx-p0', ((splitX - x) / w).toFixed(4));
    rect.style.setProperty('--tx-steps', String(clamp(steps, 1, 200)));
    setDur(rect, spec.dur);
    setDelay(rect, spec.at);

    /* Typing caret, command lines only. */
    if (spec.kind === 'cmd') {
      var caret = svgEl('rect');
      caret.setAttribute('class', 'tx-caret');
      caret.setAttribute('x', splitX);
      caret.setAttribute('y', (y + 3).toFixed(2));
      caret.setAttribute('width', '8.5');
      caret.setAttribute('height', Math.max(12, h - 8).toFixed(2));
      caret.style.setProperty('--tx-x0', '0px');
      caret.style.setProperty('--tx-x1', ((x + w - pad) - splitX).toFixed(2) + 'px');
      caret.style.setProperty('--tx-steps', String(clamp(steps, 1, 200)));
      setDur(caret, spec.dur);
      setDelay(caret, spec.at);
      S.fx.appendChild(caret);
    }
    return text;
  }

  function wireArtwork() {
    var svg = S.root.querySelector('svg');
    if (!svg) { return; }
    S.svg = svg;
    svg.setAttribute('aria-hidden', 'true');
    svg.setAttribute('preserveAspectRatio', 'xMidYMid meet');
    svg.removeAttribute('role');
    svg.removeAttribute('aria-labelledby');

    var defs = buildDefs(svg);

    /* FX overlay - all added geometry lives here, above the artwork. */
    var fx = svgEl('g');
    fx.setAttribute('id', 'tx-fx');
    svg.appendChild(fx);
    S.fx = fx;

    /* --- field ---------------------------------------------------- */
    var bezel = S.root.querySelector('.tx-bezel');
    if (bezel) { setDelay(bezel, CUES.field); }

    var bg = byId('background');
    if (bg) { bg.classList.add('tx-bg'); setDelay(bg, CUES.field); }
    var tex = byId('background-texture');
    if (tex) { tex.classList.add('tx-grid-tex'); setDelay(tex, CUES.field + 0.12); }

    var orbit = byId('ellipse9');
    if (orbit) {
      var L = ellipseLength(orbit);
      orbit.classList.add('tx-orbit');
      orbit.style.strokeDasharray = L.toFixed(2);
      orbit.style.setProperty('--tx-len', L.toFixed(2));
      setDelay(orbit, CUES.orbit);
    }
    var dashed = byId('ellipse10');
    if (dashed) { dashed.classList.add('tx-orbit-dashed'); setDelay(dashed, CUES.orbitDash); }

    /* Comet arcs riding the outer orbit. */
    if (dashed) {
      var cl = ellipseLength(dashed);
      ['tx-comet-head', 'tx-comet-tail'].forEach(function (variant, i) {
        var c = svgEl('ellipse');
        c.setAttribute('cx', dashed.getAttribute('cx') || 640);
        c.setAttribute('cy', dashed.getAttribute('cy') || 416);
        c.setAttribute('rx', dashed.getAttribute('rx') || 520);
        c.setAttribute('ry', dashed.getAttribute('ry') || 356);
        c.setAttribute('class', 'tx-comet ' + variant);
        var seg = i === 0 ? cl * 0.035 : cl * 0.11;
        c.style.strokeDasharray = seg.toFixed(2) + ' ' + (cl - seg).toFixed(2);
        c.style.setProperty('--tx-len', cl.toFixed(2));
        c.style.setProperty('--tx-lenneg', '-' + cl.toFixed(2));
        setDelay(c, CUES.orbitDash + (i === 0 ? 0.25 : 0.1));
        fx.insertBefore(c, fx.firstChild);
      });
    }

    /* --- terminal chassis ----------------------------------------- */
    var term = byId('terminal-area');
    if (term) { term.classList.add('tx-term'); setDelay(term, CUES.shell); }

    ['text-mark', 'localhost'].forEach(function (id) {
      var el = byId(id);
      if (el) { el.classList.add('tx-term-bits'); setDelay(el, CUES.shellBits); }
    });
    ['terminal-divider', 'metadata'].forEach(function (id, i) {
      var el = byId(id);
      if (el) { el.classList.add('tx-term-bits'); setDelay(el, CUES.chrome + i * 0.12); }
    });

    /* --- session lines -------------------------------------------- */
    LINES.forEach(function (spec, i) { wireLine(svg, defs, spec, i); });

    var cursor = byId('cursor-indicator');
    if (cursor) { cursor.classList.add('tx-cursor'); }

    /* --- connector wires ------------------------------------------ */
    var wires = byId('indicator-dahses-dots');
    if (wires) { wires.classList.add('tx-wire'); setDelay(wires, CUES.bus); }

    /* --- per-node traces, sparks, rings, chips, labels ------------- */
    NODES.forEach(function (n, i) {
      var at = CUES.traceAt + i * CUES.traceStep;
      var land = at + CUES.traceDur * CUES.mountLead;

      var wire = byId(n.wire);
      if (wire) {
        var tr = svgEl('path');
        tr.setAttribute('d', wire.getAttribute('d'));
        tr.setAttribute('pathLength', '100');
        tr.setAttribute('class', 'tx-trace');
        tr.setAttribute('stroke', n.hue);
        setDur(tr, CUES.traceDur);
        setDelay(tr, at);
        fx.appendChild(tr);
      }

      var spark = svgEl('circle');
      spark.setAttribute('cx', n.dot[0]); spark.setAttribute('cy', n.dot[1]);
      spark.setAttribute('r', '3.4');
      spark.setAttribute('fill', n.hue);
      spark.setAttribute('filter', 'url(#tx-glow)');
      spark.setAttribute('class', 'tx-spark');
      setDelay(spark, land);
      fx.appendChild(spark);

      var ring = svgEl('circle');
      ring.setAttribute('cx', n.dot[0]); ring.setAttribute('cy', n.dot[1]);
      ring.setAttribute('r', '16');
      ring.setAttribute('stroke', n.hue);
      ring.setAttribute('class', 'tx-arrival');
      setDelay(ring, land);
      fx.appendChild(ring);

      var group = byId(n.group);
      if (group) {
        group.classList.add('tx-node');
        group.style.setProperty('--tx-d2', (1 + i * 0.42).toFixed(2) + 's');
      }
      var chip = byId(n.chip);
      if (chip) { chip.classList.add('tx-chip'); setDelay(chip, land); }
      var label = byId(n.label);
      if (label) { label.classList.add('tx-label'); setDelay(label, land + 0.16); }

      n._mountAt = land;
    });

    /* --- synchronization pulse ------------------------------------ */
    var sync = svgEl('ellipse');
    sync.setAttribute('cx', '640'); sync.setAttribute('cy', '416');
    sync.setAttribute('rx', '520'); sync.setAttribute('ry', '356');
    sync.setAttribute('class', 'tx-sync');
    setDelay(sync, CUES.sync);
    fx.appendChild(sync);

    frame();
  }

  /* Choose the viewBox crop that suits the stage's aspect ratio, then seat
     the screen bezel on the rect the artwork actually paints into. Both
     derive from the same measurement, so the frame can never drift away
     from the art it frames. */
  function frame() {
    if (!S.svg || !S.stage) { return; }
    var r = S.stage.getBoundingClientRect();
    if (!r.width || !r.height) { return; }

    var ar = r.width / r.height;
    var pick = FRAMES[FRAMES.length - 1];
    for (var i = 0; i < FRAMES.length; i++) {
      if (ar >= FRAMES[i].min) { pick = FRAMES[i]; break; }
    }
    if (S.frameBox !== pick.box) {
      S.frameBox = pick.box;
      S.svg.setAttribute('viewBox', pick.box);
    }

    if (!S.screen) { return; }
    /* preserveAspectRatio="xMidYMid meet" - reproduce its fit here. */
    var vb = pick.box.split(/\s+/);
    var vw = parseFloat(vb[2]), vh = parseFloat(vb[3]);
    var scale = Math.min(r.width / vw, r.height / vh);
    var w = vw * scale, h = vh * scale;
    var st = S.screen.style;
    st.left = ((r.width - w) / 2).toFixed(1) + 'px';
    st.top = ((r.height - h) / 2).toFixed(1) + 'px';
    st.width = w.toFixed(1) + 'px';
    st.height = h.toFixed(1) + 'px';
  }

  /* ================================================== chrome updates = */

  function pushLog(message, level, atSeconds) {
    var line = document.createElement('div');
    line.className = 'tx-log-line';
    line.setAttribute('data-level', level || 'ok');
    var t = document.createElement('span');
    t.className = 'tx-t';
    t.textContent = fmtClock(atSeconds === undefined ? S.t : atSeconds);
    var m = document.createElement('span');
    m.className = 'tx-m';
    m.textContent = message;
    var s = document.createElement('span');
    s.className = 'tx-s';
    s.textContent = level === 'warn' ? 'warn' : (level === 'info' ? '..' : 'ok');
    line.appendChild(t); line.appendChild(m); line.appendChild(s);
    S.log.appendChild(line);
    while (S.log.children.length > 9) { S.log.removeChild(S.log.firstChild); }
  }

  function setPhase(text) {
    if (S.phaseText === text) { return; }
    S.phaseText = text;
    S.phaseEl.textContent = text;
    S.sr.textContent = 'Loading: ' + text + '.';
    emit('phase', { phase: text });
  }

  function paintProgress(pct) {
    pct = clamp(pct, 0, 100);
    if (Math.round(pct) !== S.shownPct) {
      S.shownPct = Math.round(pct);
      S.pctEl.textContent = S.shownPct;
      S.rail.setAttribute('aria-valuenow', S.shownPct);
      emit('progress', { value: pct / 100 });
    }
  }

  function lightSegment(i) {
    var seg = S.segs[i];
    if (seg && seg.getAttribute('data-on') !== '1') { seg.setAttribute('data-on', '1'); }
  }

  /* ======================================================= sequencing = */

  function tick(now) {
    if (!S || S.done) { return; }
    var realMs = now - S.t0 - S.pausedFor;
    if (!S.paused) {
      S.t = (realMs / 1000) * S.speed;
    }
    var t = S.t;

    /* Fail-safe on the same pause-adjusted clock, so a backgrounded tab
       cannot trip it while the sequence is frozen. */
    if (!S.completing && realMs > S.opts.failsafe) {
      pushLog('fail-safe timeout \u00b7 handing off', 'warn');
      skip();
      return;
    }

    /* phase label */
    for (var p = PHASES.length - 1; p >= 0; p--) {
      if (t >= PHASES[p][0]) { setPhase(PHASES[p][1]); break; }
    }

    /* boot log */
    while (S.logIndex < LOG.length && t >= LOG[S.logIndex][0]) {
      var entry = LOG[S.logIndex];
      pushLog(entry[1], entry[2], entry[0]);
      S.logIndex++;
    }

    /* rail segments follow node mounts */
    for (var i = 0; i < NODES.length; i++) {
      if (t >= NODES[i]._mountAt) { lightSegment(i); }
    }

    /* cursor becomes visible once the prompt line lands */
    if (!S.cursorOn && t >= CUES.cursor) {
      S.cursorOn = true;
      S.root.classList.add('tx-cursor-on');
    }

    /* idle breathing once the constellation is up */
    if (!S.live && t >= CUES.sync) {
      S.live = true;
      S.root.classList.add('tx-live');
    }

    /* progress: scripted, held at 97 in manual mode, floored by any
       externally reported value so real loading can run ahead.        */
    var scripted = interp(PROGRESS, t);
    if (!S.opts.auto && !S.completing) { scripted = Math.min(scripted, 97); }
    paintProgress(Math.max(scripted, S.external * 100));

    if (!S.ready && t >= CUES.ready && (S.opts.auto || S.completing)) { markReady(); }
    if (S.opts.auto && !S.completing && t >= CUES.outro) { complete(); }

    S.raf = requestAnimationFrame(tick);
  }

  function markReady() {
    if (S.ready) { return; }
    S.ready = true;
    S.root.classList.add('tx-ready');
    setPhase('ready');
    S.sr.textContent = 'Ready.';
    S.root.setAttribute('aria-busy', 'false');
    S.skipBtn.innerHTML = 'enter <kbd>\u21b5</kbd>';
    emit('ready', {});
  }

  function finish() {
    if (S.done) { return; }
    S.done = true;
    if (S.raf) { cancelAnimationFrame(S.raf); }
    for (var i = 0; i < NODES.length; i++) { lightSegment(i); }
    paintProgress(100);
    markReady();

    var root = S.root;
    var wait = Math.max(0, S.opts.minMs - (performance.now() - S.t0 - S.pausedFor));
    setTimeout(function () {
      root.classList.add('tx-out');
      var closed = false;
      var close = function () {
        if (closed) { return; }
        closed = true;
        root.hidden = true;
        document.documentElement.classList.remove('tx-locked');
        if (S.prevFocus && document.contains(S.prevFocus)) {
          try { S.prevFocus.focus({ preventScroll: true }); } catch (e) {}
        }
        emit('done', {});
      };
      root.addEventListener('transitionend', close, { once: true });
      setTimeout(close, 900);
    }, wait + 380 / S.speed);
  }

  function complete() {
    if (!S || S.done || S.completing) { return; }
    S.completing = true;
    S.external = 1;
    if (S.t < CUES.ready) {
      /* Loading beat the choreography: fast-forward to the finished frame
         rather than stalling the user on an unfinished animation.       */
      S.root.classList.add('tx-static');
      S.t = CUES.ready;
    }
    markReady();
    pushLog('handoff \u2192 host runtime', 'ok');
    finish();
  }

  function skip() {
    if (!S || S.done) { return; }
    S.root.classList.add('tx-static');
    S.completing = true;
    S.t = CUES.ready;
    while (S.logIndex < LOG.length) {
      pushLog(LOG[S.logIndex][1], LOG[S.logIndex][2], LOG[S.logIndex][0]);
      S.logIndex++;
    }
    S.root.classList.add('tx-cursor-on');
    finish();
  }

  function pause() {
    if (!S || S.paused || S.done) { return; }
    S.paused = true;
    S.pausedAt = performance.now();
    S.root.classList.add('tx-paused');
    S.root.querySelectorAll('*').forEach(function (el) {
      el.style.animationPlayState = 'paused';
    });
  }

  function resume() {
    if (!S || !S.paused || S.done) { return; }
    S.pausedFor += performance.now() - S.pausedAt;
    S.paused = false;
    S.root.classList.remove('tx-paused');
    S.root.querySelectorAll('*').forEach(function (el) {
      el.style.animationPlayState = '';
    });
  }

  /* ============================================================= boot = */

  function readOptions(root) {
    var reduce = window.matchMedia &&
                 window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var motion = root.getAttribute('data-motion');
    var motionOn = motion === 'off' ? false : (motion === 'on' ? true : !reduce);
    var speed = clamp(num(root.getAttribute('data-speed'), 1), 0.25, 4);
    /* With motion suppressed there is nothing to watch, so the same cue
       sheet is played on a compressed clock instead of holding a still
       frame for the full run time. */
    if (!motionOn) { speed = clamp(speed * 2.2, 0.25, 6); }
    return {
      speed:    speed,
      auto:     root.getAttribute('data-auto') !== 'false',
      minMs:    num(root.getAttribute('data-min-ms'), 0),
      failsafe: Math.max(2000, num(root.getAttribute('data-failsafe-ms'), 16000)),
      motion:   motionOn,
      title:    root.getAttribute('data-title'),
      subtitle: root.getAttribute('data-subtitle')
    };
  }

  function boot(root) {
    var opts = readOptions(root);

    S = {
      root: root, opts: opts, speed: opts.speed,
      t: 0, t0: performance.now(), pausedFor: 0, pausedAt: 0,
      logIndex: 0, shownPct: -1, external: 0,
      ready: false, done: false, completing: false,
      paused: false, cursorOn: false, live: false,
      phaseText: '', frameBox: '',
      prevFocus: document.activeElement,
      log: root.querySelector('#tx-log'),
      phaseEl: root.querySelector('#tx-phase'),
      pctEl: root.querySelector('#tx-pct'),
      rail: root.querySelector('#tx-rail'),
      sr: root.querySelector('#tx-sr'),
      skipBtn: root.querySelector('#tx-skip'),
      stage: root.querySelector('#tx-stage'),
      screen: root.querySelector('#tx-screen'),
      segs: []
    };

    root.style.setProperty('--tx-speed', String(opts.speed));
    if (opts.title) { root.querySelector('[data-tx-title]').textContent = opts.title; }
    if (opts.subtitle) { root.querySelector('[data-tx-subtitle]').textContent = opts.subtitle; }

    /* rail segments, one per constellation node */
    S.rail.textContent = '';
    NODES.forEach(function (n) {
      var seg = document.createElement('span');
      seg.className = 'tx-seg';
      seg.setAttribute('data-on', '0');
      seg.title = n.name;
      seg.appendChild(document.createElement('i'));
      S.rail.appendChild(seg);
      S.segs.push(seg);
    });

    document.documentElement.classList.add('tx-locked');

    wireArtwork();
    if (!opts.motion) { root.classList.add('tx-static'); }

    /* controls */
    S.skipBtn.addEventListener('click', function () {
      if (S.ready) { finish(); } else { skip(); }
    });
    S.keyHandler = function (e) {
      if (!S || S.done) { return; }
      if (e.key === 'Escape') { e.preventDefault(); skip(); }
      else if ((e.key === 'Enter' || e.key === ' ') && e.target !== S.skipBtn) {
        e.preventDefault();
        if (S.ready) { finish(); } else { skip(); }
      }
    };
    document.addEventListener('keydown', S.keyHandler);

    S.resizeHandler = function () { frame(); };
    window.addEventListener('resize', S.resizeHandler, { passive: true });
    if (window.ResizeObserver) {
      S.ro = new ResizeObserver(function () { frame(); });
      S.ro.observe(S.stage);
    }

    S.visHandler = function () {
      if (document.hidden) { pause(); } else { resume(); }
    };
    document.addEventListener('visibilitychange', S.visHandler);

    try { S.skipBtn.focus({ preventScroll: true }); } catch (e) {}

    S.raf = requestAnimationFrame(tick);
  }

  function teardown() {
    if (!S) { return; }
    if (S.raf) { cancelAnimationFrame(S.raf); }
    if (S.keyHandler) { document.removeEventListener('keydown', S.keyHandler); }
    if (S.visHandler) { document.removeEventListener('visibilitychange', S.visHandler); }
    if (S.resizeHandler) { window.removeEventListener('resize', S.resizeHandler); }
    if (S.ro) { S.ro.disconnect(); }
    S.done = true;
  }

  function replay(overrides) {
    teardown();
    var current = document.getElementById(ROOT_ID);
    var fresh = PRISTINE.cloneNode(true);
    if (overrides) {
      Object.keys(overrides).forEach(function (k) {
        var attr = 'data-' + k.replace(/[A-Z]/g, function (c) { return '-' + c.toLowerCase(); });
        fresh.setAttribute(attr, String(overrides[k]));
      });
    }
    if (current) { current.parentNode.replaceChild(fresh, current); }
    else { document.body.insertBefore(fresh, document.body.firstChild); }
    fresh.hidden = false;
    /* Let layout settle so getBBox/getComputedTextLength are trustworthy. */
    requestAnimationFrame(function () { boot(fresh); });
    return API;
  }

  /* ============================================================== API = */
  var API = {
    get el() { return document.getElementById(ROOT_ID); },
    get progress() { return S ? S.shownPct / 100 : 0; },
    get isDone() { return !!(S && S.done); },
    get isRunning() { return !!(S && !S.done); },
    setProgress: function (v) {
      if (S) { S.external = clamp(num(v, 0), 0, 1); }
      return API;
    },
    task: function (message, level) {
      if (S && message) { pushLog(String(message), level || 'info'); }
      return API;
    },
    complete: complete,
    skip: skip,
    pause: pause,
    resume: resume,
    replay: replay,
    on: function (name, fn, o) {
      document.addEventListener('termux-splash:' + name, fn, o); return API;
    },
    off: function (name, fn, o) {
      document.removeEventListener('termux-splash:' + name, fn, o); return API;
    }
  };
  window.TermuxSplash = API;

  /* Start once fonts are settled - text measurement drives the typing. */
  function start() {
    var go = function () { requestAnimationFrame(function () { boot(host); }); };
    if (document.fonts && document.fonts.ready && document.fonts.ready.then) {
      document.fonts.ready.then(go).catch(go);
    } else { go(); }
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start);
  } else { start(); }
}());

/* ====================================================================
   Demo host controls - not part of the splash component. Delete this
   block when embedding into a host page.
   ==================================================================== */
(function () {
  'use strict';
  var speedSel = document.getElementById('demo-speed');
  var motionBox = document.getElementById('demo-motion');

  function opts(extra) {
    var o = { speed: speedSel ? speedSel.value : 1,
              motion: (motionBox && motionBox.checked) ? 'off' : 'on' };
    if (extra) { Object.keys(extra).forEach(function (k) { o[k] = extra[k]; }); }
    return o;
  }

  var replayBtn = document.getElementById('demo-replay');
  if (replayBtn) {
    replayBtn.addEventListener('click', function () {
      window.TermuxSplash.replay(opts({ auto: 'true' }));
    });
  }

  var manualBtn = document.getElementById('demo-manual');
  if (manualBtn) {
    manualBtn.addEventListener('click', function () {
      window.TermuxSplash.replay(opts({ auto: 'false' }));
      /* Simulated real loader: reports progress, then completes. */
      var loaded = 0;
      var steps = [
        [600,  0.25, 'fetching lesson index'],
        [1400, 0.50, 'decoding sandbox wasm'],
        [2300, 0.72, 'warming fish sandbox'],
        [3200, 0.93, 'hydrating course shell']
      ];
      steps.forEach(function (s) {
        setTimeout(function () {
          if (window.TermuxSplash.isDone) { return; }
          loaded = s[1];
          window.TermuxSplash.setProgress(loaded).task(s[2], 'info');
        }, s[0]);
      });
      setTimeout(function () { window.TermuxSplash.complete(); }, 4200);
    });
  }
}());
</script>
