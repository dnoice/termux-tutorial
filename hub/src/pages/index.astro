---
import Layout from '../layouts/Layout.astro';
import SettingsDialog from '../components/SettingsDialog.astro';
import Hero from '../components/Hero.astro';
import PromptMark from '../components/PromptMark.astro';
import SeriesDashboard from '../components/SeriesDashboard.tsx';
import { COURSES, COURSE_MANIFEST } from '../lib/courses.ts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const TITLE = 'Termux Tutorial — Linux on your Android phone';
/*
 * This is the meta description — the sentence a search result shows — so an
 * over-claim here is the first thing a stranger reads and the last thing anyone
 * thinks to check. It claimed "a live terminal in every lesson"; only the
 * beginner course is close to that, and the advanced course has none by design.
 * Kept in step with HERO_PROMISE in lib/hero.ts, which makes the same promise
 * to the same reader.
 */
const DESCRIPTION =
	'A three-part, hands-on Termux course. The first course puts a live terminal in nearly every lesson, so you can start before you install anything.';

/*
 * Reference links belong ON the course they describe, not in a list of their
 * own. As a separate section they were four near-identical bordered boxes —
 * "Beginner cheatsheet", "Beginner troubleshooting", "Intermediate cheatsheet",
 * "Intermediate troubleshooting" — where every word appeared twice and the
 * course name did all the work. They also competed with the real course cards
 * at a similar size and weight, so the eye read eight things of equal
 * importance instead of three courses.
 *
 * Moved onto the cards, each label drops its prefix: the card already says
 * which course it is.
 */
const REFS = [
	{ slug: 'reference/cheatsheet', label: 'Cheatsheet' },
	{ slug: 'reference/troubleshooting', label: 'Troubleshooting' },
];
---

<Layout title={TITLE} description={DESCRIPTION}>
	<div class="hub">
		<header class="hub__top">
			<a class="hub__mark" href={`${base}/`}>
				<PromptMark />
				Termux Tutorial
			</a>
			<SettingsDialog base={base} />
		</header>

		<div class="hub__band hub__band--lead">
		<Hero />

		<section class="hub__panel">
			<h2>Your progress</h2>
			{/* client:only — progress is per-browser, so there is nothing meaningful
			    to prerender, and a server-rendered 0% flipping to 45% on hydration
			    is a worse first frame than a one-line skeleton. */}
			<SeriesDashboard client:only="react" courses={COURSE_MANIFEST} base={base} />
		</section>
		</div>

		<section class="hub__section hub__section--courses">
		<h2>Courses</h2>
		<p class="hub__note">
			Each assumes the one before it. Used a terminal before? Skim Beginner and
			start at Intermediate — nothing is re-taught later.
		</p>

		<div class="hub__courses">
			{
				COURSES.map((c) =>
					c.present ? (
						/*
						 * An <article>, not an <a>. The card now has more than one
						 * destination, and an anchor cannot legally contain anchors.
						 * The title link stretches over the whole card via a
						 * ::after overlay, so the card is still one big target;
						 * the reference links sit above that overlay on their own
						 * z-index. Standard pattern, and it keeps the primary
						 * action obvious while giving the secondary ones a home.
						 */
						<article class="course">
							<span class="course__kicker">
								<span class="course__num">{c.number}</span>
								Course {c.number}
							</span>
							<h3 class="course__title">
								<a class="course__link" href={`${base}/${c.id}/`}>
									{c.name}
								</a>
							</h3>
							<p class="course__body">{c.blurb}</p>
							<span class="course__foot">
								<span>{c.lessons.length} lessons</span>
								<span class="course__cta">Open →</span>
							</span>
							<span class="course__refs">
								{REFS.map((r) => (
									<a href={`${base}/${c.id}/${r.slug}/`}>{r.label}</a>
								))}
							</span>
						</article>
					) : (
						<article class="course course--soon">
							<span class="course__kicker">
								<span class="course__num">{c.number}</span>
								Course {c.number}
							</span>
							<h3 class="course__title">{c.name}</h3>
							<p class="course__body">{c.blurb}</p>
							<span class="course__foot">
								<span>Not written yet</span>
							</span>
						</article>
					)
				)
			}
		</div>
		</section>

		<p class="hub__fine">
			No account, no analytics, no backend — static files only. Your name,
			avatar and progress live in this browser and are never sent anywhere,
			which is why the dashboard is empty on a new device. One exception,
			documented where it happens: booting the optional Debian sandbox fetches
			it from Leaning Technologies, and only when you click.
		</p>

		<footer class="hub__foot">
			<span>Built with Astro + Starlight. BSD 3-Clause.</span>
			<a href="https://github.com/dnoice/termux-tutorial">Source on GitHub</a>
		</footer>
	</div>
</Layout>
