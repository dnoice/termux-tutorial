{
  "name": "termux-tutorial",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/check-curriculum.mjs && astro build && node scripts/check-links.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "typecheck": "astro check",
    "fonts:sync": "node -e \"const{copyFileSync,mkdirSync}=require('node:fs');mkdirSync('public/fonts',{recursive:true});for(const[p,f]of[['inter','inter'],['crimson-pro','crimson-pro'],['source-serif-4','source-serif-4'],['jetbrains-mono','jetbrains-mono']])for(const s of['normal','italic'])copyFileSync(`node_modules/@fontsource-variable/${p}/files/${f}-latin-wght-${s}.woff2`,`public/fonts/${f}-latin-wght-${s}.woff2`);console.log('public/fonts synced from @fontsource-variable')\"",
    "check:curriculum": "node scripts/check-curriculum.mjs",
    "check:links": "node scripts/check-links.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.1",
    "@astrojs/starlight": "^0.41.3",
    "@fontsource-variable/crimson-pro": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/fa6-regular": "^1.2.4",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "astro": "^7.0.2",
    "astro-icon": "^1.1.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3"
  }
}
